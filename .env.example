# Plantilla pública: copie a .env y complete solo los valores vacíos necesarios.
# Nunca publique un .env rellenado ni copie credenciales de otro ejemplo.

# Requeridas para el núcleo y su origen de confianza.
# Genere AGENT_API_TOKEN con secrets.token_urlsafe(32).
AGENT_API_TOKEN=
# Local: http://127.0.0.1:8000 para la prueba del núcleo. Heroku: origen HTTPS exacto, sin barra final.
PUBLIC_ORIGIN=

# Perfil público inicial: Google Developer API. No sustituya con él un .env privado Vertex ya autorizado.
# Para Vertex: selector true y proyecto/ubicación explícitos; consulte CREAR_AGENTE.md.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=
# Opcionales: modelos distintos, disponibles en su cuenta; estos son los valores iniciales.
MODELO=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.5-flash

# Privacidad: mantenga las trazas desactivadas también en las bibliotecas del proveedor.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Activación explícita: false no vincula WhatsApp. La página exige además la acción Conectar.
WA_ENABLE_CONNECTION=false
# El número se introduce solo en el panel privado; no lo guarde en variables.
# Requeridas al arrancar el conector de audio, incluso si todavía no vincula WhatsApp.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
